# Copy this file to infra/.env before running docker compose:
#   cp infra/.env.example infra/.env
#
# These are LOCAL DEVELOPMENT-ONLY defaults. Never reuse these values anywhere real.

# --- PostgreSQL (Keycloak's backing store) ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak-dev-only-password

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only-password
KEYCLOAK_REALM=common-platform
# Fixed hostname so the issuer/JWKS URLs are IDENTICAL whether Keycloak is reached via
# localhost:8080 (host/browser/curl) or keycloak:8080 (container-to-container). See
# infra/README.md "Networking & issuer consistency" for why this matters.
KEYCLOAK_HOSTNAME=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ISSUER=http://keycloak:8080/realms/common-platform

# --- Application ports (host-published) ---
SPRING_API_EXAMPLE_PORT=8081
DOWNSTREAM_API_PORT=8082
